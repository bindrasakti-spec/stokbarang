{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/genap", "destination": "/genap/index.html" },
    { "source": "/gmdp", "destination": "/gmdp/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 16 * * *"
    }
  ]
}
